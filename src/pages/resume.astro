---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import resumePreview from "../assets/resume.png";
---

<Base title="Résumé">
  <div class="resume-head">
    <h1>Résumé</h1>
    <div class="buttons" style="margin: 0">
      <a class="btn" href={site.resume} target="_blank" rel="noopener">Open PDF</a>
      <a class="btn primary" href={site.resume} download>Download</a>
    </div>
  </div>

  <a class="paper" href={site.resume} target="_blank" rel="noopener" aria-label="Open résumé PDF">
    <Image
      src={resumePreview}
      alt={`Résumé of ${site.name}`}
      widths={[700, 1000, 1400]}
      sizes="(max-width: 760px) 100vw, 46rem"
      loading="eager"
    />
  </a>
</Base>
