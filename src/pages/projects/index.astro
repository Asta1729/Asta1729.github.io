---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
const groups = [
  { title: "Projects", items: projects.filter((p) => p.data.category === "Project") },
  { title: "Course projects", items: projects.filter((p) => p.data.category === "Course Project") },
].filter((g) => g.items.length > 0);
---

<Base title="Projects" description="Projects by Nirupam Punna in machine learning, AI, distributed systems and web development.">
  <h1>Projects</h1>
  <p class="muted" style="margin-bottom: 2.5rem">Things I've built. Each one links to its code on GitHub.</p>

  {
    groups.map((g) => (
      <section>
        <div class="section-title">
          <h2>{g.title}</h2>
        </div>
        <div class="cards">
          {g.items.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    ))
  }
</Base>
